[Unit]
Description=SmartESS proxy for ANENJI to Domoticz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartess
Group=smartess
WorkingDirectory=/opt/smartess-proxy
Environment=PROXY_PORT=8899
Environment=LOCAL_ONLY=1
Environment=DNS_HOST=SERVER_IP
Environment=DNS_OVERRIDE_IP=SERVER_IP
Environment=DTU_IP=INVERTER_IP
Environment=ADVERTISE_IP=SERVER_IP
Environment=DOMOTICZ_CONFIG=/opt/smartess-proxy/domoticz.json
ExecStart=/usr/bin/python3 /opt/smartess-proxy/smartess_proxy.py
Restart=always
RestartSec=3
TimeoutStopSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target


